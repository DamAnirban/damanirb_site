---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Contact - Anirban Dam"
	description="Get in touch with Anirban Dam, VLSI & Emulation Engineer, on LinkedIn."
>
	<section class="mx-auto flex min-h-[70vh] max-w-2xl items-center px-6 py-20">
		<div class="relative w-full overflow-hidden rounded-[2rem] border border-text/10 bg-canvas/70 px-6 py-14 text-center shadow-xl shadow-primary/10 backdrop-blur sm:px-12" data-reveal>
		<div aria-hidden="true" class="pointer-events-none absolute -top-20 -right-20 h-56 w-56 rounded-full bg-blush blur-2xl"></div>
		<div class="relative flex flex-col items-center">
		<p class="flex items-center justify-center gap-3 font-display text-sm font-semibold tracking-[0.2em] text-primary uppercase">
			<span class="h-0.5 w-8 rounded-full bg-coral" aria-hidden="true"></span>
			Let's connect</p>
		<h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-text sm:text-6xl">
			Stay In Touch
		</h1>
		<p class="mt-6 max-w-lg text-lg leading-relaxed text-text/80">
			Whether you’re building, exploring, or just thinking out loud - reach out. The best place to
			find me is LinkedIn.
		</p>
		<a
			href="https://www.linkedin.com/in/anirban-dam/"
			target="_blank"
			rel="noopener noreferrer"
			class="mt-10 inline-flex items-center gap-2 rounded-full bg-primary px-7 py-3.5 text-base font-semibold text-canvas shadow-lg shadow-primary/25 transition hover:-translate-y-0.5 hover:shadow-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
				<path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z" />
			</svg>
			Connect on LinkedIn
		</a>
		<p class="mt-4 text-sm text-text/60">Ciao!</p>
		</div>
		</div>
	</section>
</Layout>

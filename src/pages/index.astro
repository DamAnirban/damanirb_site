---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import portrait from '../assets/images/anirban-dam-hero.png';
import purposeImage from '../assets/images/building-with-purpose.jpg';

const steps = [
	{
		emoji: '⚡️',
		title: 'Spark',
		body: 'An idea strikes — maybe from a bug, a book, or a caffeine high.',
	},
	{
		emoji: '🤿',
		title: 'Dive',
		body: 'Skim the docs. Read papers. Open 10 browser tabs. Pretend it’s productive.',
	},
	{
		emoji: '🛠',
		title: 'Build Ugly',
		body: 'Proof-of-concept time. Write code, test flows, sketch things out. Looks messy? Good. It’s working.',
	},
	{
		emoji: '🔍',
		title: 'Break & Debug',
		body: 'Things fall apart — and that’s the plan. Break it to remake it better.',
	},
	{
		emoji: '♻️',
		title: 'Iterate',
		body: 'Fix. Tweak. Rebuild. Repeat. This loop is where compounding kicks in.',
	},
	{
		emoji: '🚀',
		title: 'Share, Archive or Ship',
		body: 'Write. Blog. Explain. Save for later or push it out to the world — either way, it’s another brick in the wall.',
	},
];
---

<Layout
	title="Anirban Dam — VLSI & Emulation Engineer"
	description="Anirban Dam is a VLSI & Emulation Engineer and robotics hobbyist who designs hardware flows, automates chip design methodology, and shares what he learns across code, circuits, and content."
>
	<!-- Hero -->
	<section class="bg-canvas mx-auto flex max-w-5xl flex-col-reverse items-center gap-12 px-6 py-16 sm:py-24 lg:flex-row lg:gap-16">
		<div class="flex-1 text-center lg:text-left">
			<p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-coral">Hi, I’m</p>
			<h1 class="mt-3 text-balance font-display text-4xl font-semibold tracking-tight text-text sm:text-5xl lg:text-6xl">
				Anirban Dam.
			</h1>
			<p class="mx-auto mt-6 max-w-xl text-justify text-lg leading-relaxed text-text/80 lg:mx-0">
				A VLSI &amp; Emulation Engineer by profession and robotics hobbyist by passion. I design
				hardware flows, automate chip design methodology, and share what I learn across code,
				circuits, and content.
			</p>
			<div class="mt-8 flex flex-wrap items-center justify-center gap-4 lg:justify-start">
				<a
					href="#work"
					class="rounded-full bg-primary px-6 py-3 text-sm font-semibold text-canvas shadow-sm transition-transform hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
				>
					See How I Work
				</a>
				<a
					href="/contact"
					class="rounded-full border-2 border-text/20 px-6 py-3 text-sm font-semibold text-text transition-colors hover:border-text/40 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
				>
					Get in Touch
				</a>
			</div>
		</div>

		<div class="relative shrink-0">
			<Picture
				src={portrait}
				formats={['avif', 'webp']}
				alt="Portrait of Anirban Dam smiling, wearing a navy blazer over a white t-shirt"
				width={460}
				height={452}
				loading="eager"
				fetchpriority="high"
				class="w-72 sm:w-80 lg:w-96"
			/>
		</div>
	</section>

	<!-- Building with Purpose -->
	<section class="bg-secondary/30">
		<div class="mx-auto flex max-w-5xl flex-col items-center gap-12 px-6 py-16 sm:py-24 lg:flex-row lg:gap-16">
			<div class="flex-1 text-left">
				<h2 class="text-balance font-display text-3xl font-semibold tracking-tight text-text sm:text-4xl">
					Building with Purpose
				</h2>
				<div class="mt-6 grid gap-x-10 gap-y-5 text-justify text-lg leading-relaxed text-text/80 hyphens-auto lg:grid-cols-2">
					<div class="space-y-5">
						<p>
							Most breakthroughs don’t happen in perfect tutorials, they happen in messy
							notebooks, broken scripts and 2AM bugs. Engineering is more than just solving
							problems. It’s about asking better questions, building systems that scale, and
							sharing what you learn along the way.
						</p>
						<p>
							This site is part portfolio, part open notebook — to connect reflections,
							thoughts and people.
						</p>
					</div>
					<div class="space-y-5">
						<p>
							Whether I am automating chip design flows, building robotics projects, or deep
							diving into tools — I try to follow this: <span class="font-semibold text-primary">Learn
							deeply, simplify clearly and share generously.</span>
						</p>
						<p>
							If you are someone who builds, explores, or just thinks out loud — you might find
							something worth bookmarking.
						</p>
					</div>
				</div>
			</div>

			<div class="shrink-0">
				<Picture
					src={purposeImage}
					formats={['avif', 'webp']}
					alt="Laptop open on a wooden desk by a large window, overlooking a brick building"
					width={400}
					height={500}
					loading="lazy"
					class="w-56 rounded-3xl shadow-sm sm:w-72 lg:w-80"
				/>
			</div>
		</div>
	</section>

	<!-- Working Process -->
	<section id="work" class="mx-auto max-w-5xl scroll-mt-20 px-6 py-16 sm:py-24">
		<h2 class="text-balance font-display text-3xl font-semibold tracking-tight text-text sm:text-4xl">
			Working Process
		</h2>
		<ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				steps.map((step, i) => (
					<li class="relative rounded-2xl border border-secondary/40 bg-blush/30 p-6 shadow-sm">
						<span
							class="absolute -top-3 -left-3 flex h-8 w-8 items-center justify-center rounded-full bg-primary text-sm font-bold text-canvas ring-4 ring-secondary/40"
							aria-hidden="true"
						>
							{i + 1}
						</span>
						<span class="text-3xl" aria-hidden="true">
							{step.emoji}
						</span>
						<h3 class="mt-3 font-display text-lg font-semibold text-text">{step.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-text/70">{step.body}</p>
					</li>
				))
			}
		</ol>
	</section>

	<!-- Stay In Touch -->
	<section class="bg-primary">
		<div class="mx-auto max-w-3xl px-6 py-16 text-center sm:py-20">
			<h2 class="text-balance font-display text-3xl font-semibold tracking-tight text-canvas sm:text-4xl">
				Stay In Touch
			</h2>
			<p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-canvas/80">
				Feel free to check out my contact page to stay in touch, Ciao!
			</p>
			<a
				href="/contact"
				class="mt-8 inline-block rounded-full bg-canvas px-6 py-3 text-sm font-semibold text-primary shadow-sm transition-transform hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-canvas focus-visible:ring-offset-2 focus-visible:ring-offset-primary"
			>
				Go to Contact
			</a>
		</div>
	</section>
</Layout>

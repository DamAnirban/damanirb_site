---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import CircuitTraces from '../components/CircuitTraces.astro';
import Workbench from '../components/Workbench.astro';
import portrait from '../assets/images/anirban-dam-hero.png';
import purposeImage from '../assets/images/building-with-purpose.jpg';

const steps = [
	{
		emoji: '⚡️',
		title: 'Spark',
		body: 'An idea strikes - maybe from a bug, a book, or a caffeine high.',
	},
	{
		emoji: '🤿',
		title: 'Dive',
		body: 'Skim the docs. Read papers. Open 10 browser tabs. Pretend it’s productive.',
	},
	{
		emoji: '🛠',
		title: 'Build Ugly',
		body: 'Proof-of-concept time. Write code, test flows, sketch things out. Looks messy? Good. It’s working.',
	},
	{
		emoji: '🔍',
		title: 'Break & Debug',
		body: 'Things fall apart - and that’s the plan. Break it to remake it better.',
	},
	{
		emoji: '♻️',
		title: 'Iterate',
		body: 'Fix. Tweak. Rebuild. Repeat. This loop is where compounding kicks in.',
	},
	{
		emoji: '🚀',
		title: 'Share, Archive or Ship',
		body: 'Write. Blog. Explain. Save for later or push it out to the world - either way, it’s another brick in the wall.',
	},
];

const focusAreas = ['VLSI', 'Emulation', 'Robotics'];
---

<Layout
	title="Anirban Dam - VLSI & Emulation Engineer"
	description="Anirban Dam is a VLSI & Emulation Engineer and robotics hobbyist who designs hardware flows, automates chip design methodology, and shares what he learns across code, circuits, and content."
>
	<!-- Hero -->
	<section class="mx-auto flex max-w-5xl flex-col-reverse items-center gap-12 px-6 pt-12 pb-20 sm:pt-20 sm:pb-28 lg:flex-row lg:gap-16">
		<div class="flex-1 text-center lg:text-left">
			<p class="inline-flex items-center gap-2 rounded-full border border-secondary/60 bg-surface py-1.5 pr-4 pl-2 text-sm font-medium text-text/90 shadow-sm">
				<span class="relative flex h-2.5 w-2.5" aria-hidden="true">
					<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-coral opacity-60"></span>
					<span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-coral"></span>
				</span>
				Hi, I’m
			</p>
			<h1 class="mt-5 text-balance font-display text-5xl font-bold tracking-tight text-text sm:text-6xl lg:text-7xl">
				Anirban<br class="hidden lg:block" /> Dam<span class="text-coral">.</span>
			</h1>
			<ul class="mt-6 flex flex-wrap justify-center gap-2 lg:justify-start" aria-label="Focus areas">
				{
					focusAreas.map((area) => (
						<li class="rounded-lg border border-text/10 bg-blush/60 px-3 py-1 font-display text-xs font-semibold tracking-[0.15em] text-primary uppercase">
							{area}
						</li>
					))
				}
			</ul>
			<p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-text/90 lg:mx-0">
				A VLSI &amp; Emulation Engineer by profession and robotics hobbyist by passion. I design
				hardware flows, automate chip design methodology, and share what I learn across code,
				circuits, and content.
			</p>
			<div class="mt-9 flex flex-wrap items-center justify-center gap-4 lg:justify-start">
				<a
					href="#work"
					class="group inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-canvas shadow-lg shadow-primary/25 transition hover:-translate-y-0.5 hover:shadow-xl hover:shadow-primary/30 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
				>
					See How I Work
					<span aria-hidden="true" class="transition-transform group-hover:translate-y-0.5">↓</span>
				</a>
				<a
					href="/contact"
					class="group inline-flex items-center gap-2 rounded-full border-2 border-text/20 bg-surface px-6 py-3 text-sm font-semibold text-text transition-colors hover:border-primary hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
				>
					Get in Touch
					<span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
				</a>
			</div>
		</div>

		<div class="relative shrink-0">
			<!-- Decoration behind the portrait -->
			<div aria-hidden="true" class="pointer-events-none absolute inset-0">
				<div class="absolute inset-6 rounded-full bg-linear-to-br from-secondary/40 via-blush/70 to-coral/25 blur-2xl"></div>
				<svg class="animate-spin-slow absolute -inset-6 h-[calc(100%+3rem)] w-[calc(100%+3rem)] text-primary/30" viewBox="0 0 100 100" fill="none">
					<circle cx="50" cy="50" r="48" stroke="currentColor" stroke-width="0.4" stroke-dasharray="1 3" />
					<circle cx="50" cy="2" r="1.4" class="fill-coral" />
					<circle cx="2" cy="50" r="1" class="fill-primary" />
				</svg>
			</div>
			<Picture
				src={portrait}
				formats={['avif', 'webp']}
				alt="Portrait of Anirban Dam smiling, wearing a navy blazer over a white t-shirt"
				width={460}
				height={452}
				loading="eager"
				fetchpriority="high"
				class="relative w-72 drop-shadow-xl sm:w-80 lg:w-96"
			/>
			<div
				aria-hidden="true"
				class="animate-float absolute -top-4 -left-8 flex items-center gap-2 rounded-2xl border border-text/10 bg-surface px-4 py-2.5 text-sm font-semibold text-text shadow-lg sm:-left-10"
			>
				<span class="text-lg">🔬</span> Silicon by day
			</div>
			<div
				aria-hidden="true"
				class="animate-float absolute -right-2 -bottom-2 flex items-center gap-2 rounded-2xl border border-text/10 bg-surface px-4 py-2.5 text-sm font-semibold text-text shadow-lg [animation-delay:-3.5s] sm:-right-8"
			>
				<span class="text-lg">🤖</span> Robots by night
			</div>
		</div>
	</section>

	<!-- Building with Purpose -->
	<section class="relative overflow-hidden bg-linear-to-br from-secondary/35 via-secondary/20 to-blush/50">
		<CircuitTraces class="pointer-events-none absolute -top-10 -right-20 w-[34rem] text-primary/10" />
		<div class="relative mx-auto flex max-w-5xl flex-col items-center gap-14 px-6 py-20 sm:py-28 lg:flex-row lg:gap-16">
			<div class="flex-1" data-reveal>
				<p class="flex items-center gap-3 font-display text-sm font-semibold tracking-[0.2em] text-primary uppercase">
					<span class="h-0.5 w-8 rounded-full bg-coral" aria-hidden="true"></span>
					The idea
				</p>
				<h2 class="mt-3 text-balance font-display text-3xl font-bold tracking-tight text-text sm:text-4xl">
					Building with Purpose
				</h2>
				<div class="mt-8 grid gap-x-10 gap-y-5 text-lg leading-relaxed text-text/90 lg:grid-cols-2">
					<div class="space-y-5">
						<p>
							Most breakthroughs don’t happen in perfect tutorials, they happen in messy
							notebooks, broken scripts and 2AM bugs. Engineering is more than just solving
							problems. It’s about asking better questions, building systems that scale, and
							sharing what you learn along the way.
						</p>
						<p>
							This site is part portfolio, part open notebook - to connect reflections,
							thoughts and people.
						</p>
					</div>
					<div class="space-y-5">
						<p>
							Whether I am automating chip design flows, building robotics projects, or deep
							diving into tools - I try to follow this:
						</p>
						<p class="rounded-2xl border-l-4 border-coral bg-surface px-5 py-4 font-display text-xl font-semibold text-primary shadow-sm">
							Learn deeply, simplify clearly and share generously.
						</p>
						<p>
							If you are someone who builds, explores, or just thinks out loud - you might find
							something worth bookmarking.
						</p>
					</div>
				</div>
			</div>

			<div class="relative shrink-0" data-reveal style="--reveal-delay: 150ms">
				<div aria-hidden="true" class="absolute inset-0 translate-x-4 translate-y-4 rounded-3xl border-2 border-coral"></div>
				<div aria-hidden="true" class="bg-dots absolute -top-6 -left-6 h-28 w-28 rounded-2xl"></div>
				<Picture
					src={purposeImage}
					formats={['avif', 'webp']}
					alt="Laptop open on a wooden desk by a large window, overlooking a brick building"
					width={400}
					height={500}
					loading="lazy"
					class="relative w-56 rounded-3xl shadow-xl sm:w-72 lg:w-80"
				/>
			</div>
		</div>
	</section>

	<!-- Project photos -->
	<Workbench />

	<!-- Working Process -->
	<section id="work" class="mx-auto max-w-5xl scroll-mt-20 px-6 py-20 sm:py-28">
		<div data-reveal>
			<p class="flex items-center gap-3 font-display text-sm font-semibold tracking-[0.2em] text-primary uppercase">
				<span class="h-0.5 w-8 rounded-full bg-coral" aria-hidden="true"></span>
				How I work
			</p>
			<h2 class="mt-3 text-balance font-display text-3xl font-bold tracking-tight text-text sm:text-4xl">
				Working Process
			</h2>
		</div>
		<ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				steps.map((step, i) => (
					<li data-reveal style={`--reveal-delay: ${(i % 3) * 100}ms`}>
						<div class="group relative h-full overflow-hidden rounded-2xl border border-text/10 bg-surface p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-secondary hover:shadow-xl hover:shadow-primary/10">
							<span
								class="pointer-events-none absolute -top-4 right-3 font-display text-8xl font-bold text-secondary/25 transition-colors duration-300 select-none group-hover:text-coral/25"
								aria-hidden="true"
							>
								{String(i + 1).padStart(2, '0')}
							</span>
							<span
								class="relative flex h-12 w-12 items-center justify-center rounded-xl bg-blush text-2xl ring-1 ring-coral/30 transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-6"
								aria-hidden="true"
							>
								{step.emoji}
							</span>
							<h3 class="relative mt-5 font-display text-lg font-semibold text-text">{step.title}</h3>
							<p class="relative mt-2 text-sm leading-relaxed text-text/85">{step.body}</p>
							<span
								class="absolute inset-x-0 bottom-0 h-1 origin-left scale-x-0 bg-linear-to-r from-primary via-secondary to-coral transition-transform duration-500 group-hover:scale-x-100"
								aria-hidden="true"
							/>
						</div>
					</li>
				))
			}
		</ol>
	</section>

	<!-- Stay In Touch -->
	<section class="px-6 pb-20 sm:pb-28">
		<div class="relative mx-auto max-w-5xl overflow-hidden rounded-[2rem] bg-primary shadow-2xl shadow-primary/30" data-reveal>
			<CircuitTraces class="pointer-events-none absolute -bottom-16 -left-16 w-[30rem] text-canvas/10" />
			<CircuitTraces class="pointer-events-none absolute -top-20 -right-24 w-[30rem] rotate-180 text-canvas/10" />
			<div aria-hidden="true" class="pointer-events-none absolute -top-24 left-1/2 h-64 w-64 -translate-x-1/2 rounded-full bg-coral/40 blur-3xl"></div>
			<div class="relative px-6 py-16 text-center sm:py-20">
				<h2 class="text-balance font-display text-3xl font-bold tracking-tight text-canvas sm:text-5xl">
					Stay In Touch
				</h2>
				<p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-canvas/85">
					Feel free to check out my contact page to stay in touch, Ciao!
				</p>
				<a
					href="/contact"
					class="group mt-9 inline-flex items-center gap-2 rounded-full bg-canvas px-7 py-3.5 text-sm font-semibold text-primary shadow-lg transition hover:-translate-y-0.5 hover:bg-blush focus:outline-none focus-visible:ring-2 focus-visible:ring-canvas focus-visible:ring-offset-2 focus-visible:ring-offset-primary"
				>
					Go to Contact
					<span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
				</a>
			</div>
		</div>
	</section>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
const filters = [
	{ id: 'all', label: 'All', count: posts.length },
	{ id: 'video', label: 'Videos', count: posts.filter((post) => post.data.type === 'video').length },
	{ id: 'article', label: 'Articles', count: posts.filter((post) => post.data.type === 'article').length },
];
---

<Layout
	title="Blog - Anirban Dam"
	description="Articles and VLSI video lessons by Anirban Dam, with lecture notes to download."
>
	<section class="mx-auto max-w-6xl px-6 pt-14 pb-20 sm:pt-20">
		<p class="flex items-center gap-3 font-display text-sm font-semibold tracking-[0.2em] text-primary uppercase">
			<span class="h-0.5 w-8 rounded-full bg-coral" aria-hidden="true"></span>
			Blog
		</p>
		<div class="mt-3 flex flex-wrap items-end justify-between gap-6">
			<div>
				<h1 class="font-display text-4xl font-bold tracking-tight text-text sm:text-6xl">Notes &amp; videos</h1>
				<p class="mt-4 max-w-xl text-lg leading-relaxed text-text/80">
					Articles, and VLSI video lessons with lecture notes you can download.
				</p>
			</div>

			{
				posts.length > 0 && (
					<div class="flex gap-1 rounded-full bg-blush/60 p-1" role="group" aria-label="Filter posts">
						{filters.map((filter) => (
							<button
								type="button"
								data-filter={filter.id}
								aria-pressed={filter.id === 'all' ? 'true' : 'false'}
								class="rounded-full px-4 py-2 text-sm font-semibold text-text/75 transition-colors hover:text-primary aria-pressed:bg-primary aria-pressed:text-canvas aria-pressed:shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
							>
								{filter.label} <span class="opacity-70">{filter.count}</span>
							</button>
						))}
					</div>
				)
			}
		</div>

		{
			posts.length > 0 ? (
				<ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{posts.map((post, i) => (
						<li data-type={post.data.type} data-reveal style={`--reveal-delay: ${(i % 3) * 80}ms`}>
							<PostCard post={post} />
						</li>
					))}
				</ul>
			) : (
				<div class="mt-12 rounded-3xl border border-dashed border-text/20 bg-canvas/60 px-6 py-16 text-center">
					<p class="font-display text-2xl font-semibold text-text">First posts are on their way</p>
					<p class="mx-auto mt-3 max-w-md text-text/70">
						Articles and VLSI lessons will show up here as they're published.
					</p>
				</div>
			)
		}
	</section>
</Layout>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
	const items = document.querySelectorAll<HTMLElement>('li[data-type]');
	for (const button of buttons) {
		button.addEventListener('click', () => {
			const filter = button.dataset.filter;
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
			items.forEach((item) => (item.hidden = filter !== 'all' && item.dataset.type !== filter));
		});
	}
</script>

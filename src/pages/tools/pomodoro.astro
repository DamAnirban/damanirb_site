---
import Layout from '../../layouts/Layout.astro';
import { VIBES } from '../../lib/lofi';

const vibes = Object.entries(VIBES).map(([id, vibe]) => ({ id, label: vibe.label }));

const modes = [
	{ id: 'focus', label: 'Focus' },
	{ id: 'short', label: 'Short break' },
	{ id: 'long', label: 'Long break' },
];

// Progress ring geometry (viewBox units).
const RADIUS = 54;
const CIRCUMFERENCE = 2 * Math.PI * RADIUS;

const inputClass =
	'w-full rounded-lg border border-text/15 bg-canvas px-3 py-2 text-sm font-semibold text-text tabular-nums focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/40';
const checkboxClass = 'h-4 w-4 rounded accent-primary';
---

<Layout
	title="Pomodoro Timer - Anirban Dam"
	description="A simple Pomodoro focus timer with short and long breaks, adjustable durations, and a bell chime when each session ends."
>
	<section class="mx-auto flex max-w-xl flex-col items-center px-4 py-8 sm:py-10 lg:min-h-[calc(100dvh-73px)] lg:justify-center">
		<div class="text-center">
			<p class="flex items-center justify-center gap-3 font-display text-sm font-semibold tracking-[0.2em] text-primary uppercase">
				<span class="h-0.5 w-8 rounded-full bg-coral" aria-hidden="true"></span>
				Common Tools
			</p>
			<h1 class="mt-2 font-display text-4xl font-bold tracking-tight text-text">Pomodoro</h1>
		</div>

		<div
			id="pomodoro"
			data-mode="focus"
			class="group/timer mt-6 w-full rounded-[2rem] border border-text/10 bg-canvas/80 px-5 py-6 shadow-xl shadow-primary/10 backdrop-blur sm:px-8"
		>
			<!-- Mode switcher -->
			<div class="grid grid-cols-3 gap-1 rounded-full bg-blush/60 p-1" role="group" aria-label="Timer mode">
				{
					modes.map((mode) => (
						<button
							type="button"
							data-mode-button={mode.id}
							aria-pressed={mode.id === 'focus' ? 'true' : 'false'}
							class="rounded-full px-2 py-2 text-xs font-semibold whitespace-nowrap text-text/75 transition-colors hover:text-primary aria-pressed:bg-primary aria-pressed:text-canvas aria-pressed:shadow-sm sm:text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
						>
							{mode.label}
						</button>
					))
				}
			</div>

			<!-- Progress ring -->
			<div class="relative mx-auto mt-6 aspect-square w-64 max-w-full sm:w-72">
				<div
					aria-hidden="true"
					class="absolute inset-6 rounded-full bg-secondary/30 blur-2xl transition-colors duration-500 group-data-[mode=long]/timer:bg-coral/30 group-data-[mode=short]/timer:bg-secondary/40"
				>
				</div>
				<svg class="relative h-full w-full -rotate-90" viewBox="0 0 120 120" aria-hidden="true">
					<circle cx="60" cy="60" r={RADIUS} fill="none" stroke-width="6" class="stroke-text/10" />
					<circle
						id="ring"
						cx="60"
						cy="60"
						r={RADIUS}
						fill="none"
						stroke-width="6"
						stroke-linecap="round"
						stroke-dasharray={CIRCUMFERENCE}
						stroke-dashoffset={CIRCUMFERENCE}
						data-circumference={CIRCUMFERENCE}
						class="stroke-primary transition-[stroke-dashoffset,stroke] duration-300 ease-linear group-data-[mode=long]/timer:stroke-coral group-data-[mode=short]/timer:stroke-secondary"
					/>
				</svg>
				<div class="absolute inset-0 flex flex-col items-center justify-center">
					<p id="mode-label" class="text-sm font-semibold tracking-[0.15em] text-text/70 uppercase">Focus</p>
					<p id="time" role="timer" aria-label="Time remaining" class="font-display text-6xl font-bold tracking-tight text-text tabular-nums sm:text-7xl">
						25:00
					</p>
					<p id="session-label" class="mt-1 text-sm text-text/70">Session 1 of 4</p>
				</div>
			</div>

			<!-- Controls -->
			<div class="mt-6 flex items-center justify-center gap-4">
				<button
					id="reset"
					type="button"
					aria-label="Reset timer"
					title="Reset (R)"
					class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-text/15 text-text/70 transition hover:border-primary hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
				>
					<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" />
					</svg>
				</button>
				<button
					id="toggle"
					type="button"
					title="Start / pause (Space)"
					class="flex h-16 min-w-40 items-center justify-center gap-2 rounded-full bg-primary px-8 text-lg font-semibold text-canvas shadow-lg shadow-primary/30 transition hover:-translate-y-0.5 hover:shadow-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
				>
					<svg id="icon-play" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86A1 1 0 0 0 8 5.14z" />
					</svg>
					<svg id="icon-pause" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" hidden>
						<rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" />
					</svg>
					<span id="toggle-label">Start</span>
				</button>
				<button
					id="skip"
					type="button"
					aria-label="Skip to next session"
					title="Skip (S)"
					class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-text/15 text-text/70 transition hover:border-primary hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
				>
					<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M5 5.6v12.8a1 1 0 0 0 1.55.83L15 13.2V18a1 1 0 0 0 2 0V6a1 1 0 0 0-2 0v4.8L6.55 4.77A1 1 0 0 0 5 5.6z" />
					</svg>
				</button>
			</div>

			<!-- Cycle progress and today's tally -->
			<div class="mt-6 flex flex-col items-center gap-2">
				<div id="cycle-dots" class="flex gap-2" aria-hidden="true"></div>
				<p class="text-sm text-text/70">
					Today: <span id="today-sessions" class="font-semibold text-text">0 sessions</span> · <span id="today-minutes" class="font-semibold text-text">0 min</span> focused
				</p>
			</div>
		</div>

		<!-- Lofi music, generated live in the browser (src/lib/lofi.ts) -->
		<div id="lofi" class="group/lofi mt-4 w-full rounded-2xl border border-text/10 bg-canvas/70 px-5 py-4 backdrop-blur">
			<div class="flex items-center gap-4">
				<button
					id="lofi-toggle"
					type="button"
					aria-pressed="false"
					aria-label="Play lofi music"
					class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary text-canvas shadow-md shadow-primary/25 transition hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
				>
					<svg class="h-4 w-4 group-data-[playing]/lofi:hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86A1 1 0 0 0 8 5.14z" />
					</svg>
					<svg class="hidden h-4 w-4 group-data-[playing]/lofi:block" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" />
					</svg>
				</button>
				<div class="min-w-0 flex-1">
					<p class="text-sm font-semibold text-text">Lofi beats</p>
					<p class="text-xs text-text/65">Made live in your browser, never the same twice</p>
				</div>
				<div class="flex h-6 items-end gap-[3px]" aria-hidden="true">
					{[0.9, 0.5, 1.2, 0.7].map((speed) => (
						<span
							class="eq-bar w-1 rounded-full bg-coral"
							style={`--eq-speed: ${speed}s`}
						/>
					))}
				</div>
			</div>

			<div class="mt-4 grid grid-cols-3 gap-1 rounded-full bg-blush/60 p-1" role="group" aria-label="Music vibe">
				{
					vibes.map((vibe, i) => (
						<button
							type="button"
							data-vibe={vibe.id}
							aria-pressed={i === 0 ? 'true' : 'false'}
							class="rounded-full px-2 py-1.5 text-xs font-semibold whitespace-nowrap text-text/75 transition-colors hover:text-primary aria-pressed:bg-canvas aria-pressed:text-primary aria-pressed:shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
						>
							{vibe.label}
						</button>
					))
				}
			</div>

			<div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm text-text/80">
				<label class="flex min-w-40 flex-1 items-center gap-2">
					<svg class="h-4 w-4 shrink-0 text-text/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M11 5 6 9H2v6h4l5 4V5z" /><path d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14" />
					</svg>
					<span class="sr-only">Music volume</span>
					<input id="lofi-volume" type="range" min="0" max="100" class="w-full accent-primary" />
				</label>
				<label class="flex items-center gap-2"><input id="lofi-rain" type="checkbox" class={checkboxClass} /> Rain</label>
				<label class="flex items-center gap-2"><input id="lofi-crackle" type="checkbox" class={checkboxClass} /> Vinyl crackle</label>
				<label class="flex items-center gap-2"><input id="lofi-follow" type="checkbox" class={checkboxClass} /> Play during focus only</label>
			</div>
		</div>

		<!-- Settings -->
		<details class="group mt-4 w-full rounded-2xl border border-text/10 bg-canvas/70 backdrop-blur">
			<summary
				class="flex cursor-pointer list-none items-center justify-between rounded-2xl px-5 py-3 text-sm font-semibold text-text marker:hidden focus:outline-none focus-visible:ring-2 focus-visible:ring-primary [&::-webkit-details-marker]:hidden"
			>
				Settings
				<svg class="h-4 w-4 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
					<path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06z" clip-rule="evenodd" />
				</svg>
			</summary>
			<form id="settings" class="grid gap-4 border-t border-text/10 px-5 py-4">
				<div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
					<label class="text-xs font-medium text-text/75">
						Focus (min)
						<input name="focus" type="number" min="1" max="120" required class:list={[inputClass, 'mt-1']} />
					</label>
					<label class="text-xs font-medium text-text/75">
						Short break
						<input name="short" type="number" min="1" max="60" required class:list={[inputClass, 'mt-1']} />
					</label>
					<label class="text-xs font-medium text-text/75">
						Long break
						<input name="long" type="number" min="1" max="60" required class:list={[inputClass, 'mt-1']} />
					</label>
					<label class="text-xs font-medium text-text/75">
						Long break every
						<input name="longEvery" type="number" min="2" max="10" required class:list={[inputClass, 'mt-1']} />
					</label>
				</div>
				<div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-text/80">
					<label class="flex items-center gap-2"><input name="autoBreaks" type="checkbox" class={checkboxClass} /> Auto-start breaks</label>
					<label class="flex items-center gap-2"><input name="autoFocus" type="checkbox" class={checkboxClass} /> Auto-start focus</label>
					<span class="flex items-center gap-2">
						<label class="flex items-center gap-2"><input name="sound" type="checkbox" class={checkboxClass} /> Chime when done</label>
						<button
							id="test-chime"
							type="button"
							class="rounded-full border border-text/15 px-2.5 py-0.5 text-xs font-semibold text-primary transition-colors hover:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
						>
							Test
						</button>
					</span>
				</div>
				<p class="text-xs text-text/60">Settings are saved in this browser only.</p>
			</form>
		</details>

		<p class="mt-4 text-xs text-text/60">
			Shortcuts: <kbd class="rounded border border-text/20 px-1.5 py-0.5 font-sans">Space</kbd> start/pause · <kbd class="rounded border border-text/20 px-1.5 py-0.5 font-sans">R</kbd> reset · <kbd class="rounded border border-text/20 px-1.5 py-0.5 font-sans">S</kbd> skip
		</p>

		<p id="announcer" class="sr-only" aria-live="polite"></p>
	</section>
</Layout>

<style>
	.eq-bar {
		height: 30%;
		opacity: 0.45;
		transition: height 0.3s ease;
	}
	#lofi[data-playing] .eq-bar {
		opacity: 1;
		animation: eq var(--eq-speed) ease-in-out infinite alternate;
	}
	@keyframes eq {
		from {
			height: 20%;
		}
		to {
			height: 100%;
		}
	}
</style>

<script>
	import { LofiPlayer, type VibeId } from '../../lib/lofi';

	type Mode = 'focus' | 'short' | 'long';

	interface Settings {
		focus: number;
		short: number;
		long: number;
		longEvery: number;
		autoBreaks: boolean;
		autoFocus: boolean;
		sound: boolean;
		vibe: VibeId;
		volume: number;
		rain: boolean;
		crackle: boolean;
		musicFollowsFocus: boolean;
	}

	const SETTINGS_KEY = 'pomodoro:settings';
	const STATS_KEY = 'pomodoro:today';
	const DEFAULTS: Settings = { focus: 25, short: 5, long: 15, longEvery: 4, autoBreaks: true, autoFocus: false, sound: true,
		vibe: 'night', volume: 60, rain: false, crackle: true, musicFollowsFocus: false };
	const MODE_LABELS: Record<Mode, string> = { focus: 'Focus', short: 'Short break', long: 'Long break' };
	const PAGE_TITLE = document.title;

	// localStorage can throw (private mode, blocked storage), so every access is guarded.
	function load<T>(key: string, fallback: T): T {
		try {
			const raw = localStorage.getItem(key);
			return raw ? { ...fallback, ...JSON.parse(raw) } : fallback;
		} catch {
			return fallback;
		}
	}
	function save(key: string, value: unknown) {
		try {
			localStorage.setItem(key, JSON.stringify(value));
		} catch {
			/* storage unavailable; settings just won't persist */
		}
	}

	const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
	const root = $('pomodoro');
	const ring = document.getElementById('ring')!;
	const circumference = Number(ring.dataset.circumference);
	const timeEl = $('time');
	const toggleButton = $<HTMLButtonElement>('toggle');
	const form = $<HTMLFormElement>('settings');

	let settings = load<Settings>(SETTINGS_KEY, DEFAULTS);
	let mode: Mode = 'focus';
	let completedFocus = 0; // focus sessions finished in the current long-break cycle
	let remainingMs = settings.focus * 60_000;
	let endAt: number | null = null; // set while running; time is derived from it so background tabs don't drift
	let interval: number | undefined;

	const durationMs = (m: Mode) => settings[m] * 60_000;
	const isRunning = () => endAt !== null;

	function todayKey() {
		const d = new Date();
		return `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;
	}
	function readStats() {
		const stats = load(STATS_KEY, { date: todayKey(), sessions: 0, minutes: 0 });
		return stats.date === todayKey() ? stats : { date: todayKey(), sessions: 0, minutes: 0 };
	}

	function format(ms: number) {
		const totalSeconds = Math.max(0, Math.ceil(ms / 1000));
		const m = Math.floor(totalSeconds / 60);
		const s = totalSeconds % 60;
		return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
	}

	function render() {
		const time = format(remainingMs);
		timeEl.textContent = time;
		const progress = Math.min(1, Math.max(0, 1 - remainingMs / durationMs(mode)));
		ring.setAttribute('stroke-dashoffset', String(circumference * (1 - progress)));
		// A round line cap draws a dot even at zero length; hide the ring until it has progress.
		ring.style.opacity = progress > 0 ? '1' : '0';

		root.dataset.mode = mode;
		$('mode-label').textContent = MODE_LABELS[mode];
		for (const button of document.querySelectorAll<HTMLButtonElement>('[data-mode-button]')) {
			button.setAttribute('aria-pressed', String(button.dataset.modeButton === mode));
		}

		const inCycle = completedFocus % settings.longEvery;
		$('session-label').textContent =
			mode === 'focus' ? `Session ${inCycle + 1} of ${settings.longEvery}` : mode === 'long' ? 'Well earned' : 'Breathe';
		const filled = mode === 'long' && inCycle === 0 && completedFocus > 0 ? settings.longEvery : inCycle;
		$('cycle-dots').innerHTML = Array.from(
			{ length: settings.longEvery },
			(_, i) =>
				`<span class="h-2.5 w-2.5 rounded-full ${i < filled ? 'bg-coral' : 'bg-text/15'} transition-colors"></span>`,
		).join('');

		toggleButton.querySelector('#toggle-label')!.textContent = isRunning()
			? 'Pause'
			: remainingMs < durationMs(mode)
				? 'Resume'
				: 'Start';
		// SVG elements have no `.hidden` property, so toggle the attribute directly.
		document.getElementById('icon-play')!.toggleAttribute('hidden', isRunning());
		document.getElementById('icon-pause')!.toggleAttribute('hidden', !isRunning());

		const started = isRunning() || remainingMs < durationMs(mode);
		document.title = started ? `${time} · ${MODE_LABELS[mode]}` : PAGE_TITLE;

		const stats = readStats();
		$('today-sessions').textContent = `${stats.sessions} session${stats.sessions === 1 ? '' : 's'}`;
		$('today-minutes').textContent = `${stats.minutes} min`;
	}

	function tick() {
		if (endAt === null) return;
		remainingMs = endAt - Date.now();
		if (remainingMs <= 0) {
			finish();
			return;
		}
		render();
	}

	function start() {
		if (isRunning()) return;
		unlockAudio();
		endAt = Date.now() + remainingMs;
		interval = window.setInterval(tick, 250);
		render();
		syncMusicWithTimer();
	}

	function pause() {
		if (endAt === null) return;
		remainingMs = Math.max(0, endAt - Date.now());
		endAt = null;
		window.clearInterval(interval);
		render();
		syncMusicWithTimer();
	}

	function setMode(next: Mode) {
		pause();
		mode = next;
		remainingMs = durationMs(next);
		render();
		syncMusicWithTimer();
	}

	function nextMode(): Mode {
		if (mode !== 'focus') return 'focus';
		return completedFocus % settings.longEvery === 0 ? 'long' : 'short';
	}

	function finish() {
		const finished = mode;
		if (finished === 'focus') {
			completedFocus++;
			const stats = readStats();
			save(STATS_KEY, { ...stats, sessions: stats.sessions + 1, minutes: stats.minutes + settings.focus });
		}
		if (settings.sound) chime(finished === 'focus' ? 'rest' : 'work');
		const next = nextMode();
		setMode(next);
		$('announcer').textContent = `${MODE_LABELS[finished]} complete. Next: ${MODE_LABELS[next]}.`;
		if ((next === 'focus' && settings.autoFocus) || (next !== 'focus' && settings.autoBreaks)) start();
	}

	function skip() {
		// Skipping never counts as a completed session.
		if (mode === 'focus') {
			setMode((completedFocus + 1) % settings.longEvery === 0 ? 'long' : 'short');
		} else {
			setMode('focus');
		}
	}

	// Sound: a bell chime synthesised with Web Audio, so no audio file is needed.
	let audio: AudioContext | undefined;
	function unlockAudio() {
		// Browsers only allow audio after a user gesture, so create/resume it on Start.
		audio ??= new AudioContext();
		if (audio.state === 'suspended') void audio.resume();
	}

	// Bell overtones: [frequency ratio, level, decay seconds]. The inharmonic ratios
	// (2.76, 5.4, 8.93) are what make it ring like a struck metal bar rather than a beep.
	const BELL_PARTIALS: [number, number, number][] = [
		[1, 1, 3.8],
		[2, 0.35, 2.2],
		[2.76, 0.3, 1.4],
		[5.4, 0.12, 0.6],
		[8.93, 0.06, 0.35],
	];

	function bell(ctx: AudioContext, destination: AudioNode, freq: number, t: number, level: number) {
		for (const [ratio, partialLevel, decay] of BELL_PARTIALS) {
			const osc = ctx.createOscillator();
			osc.frequency.value = freq * ratio;
			const gain = ctx.createGain();
			gain.gain.setValueAtTime(0, t);
			gain.gain.linearRampToValueAtTime(level * partialLevel, t + 0.005);
			gain.gain.exponentialRampToValueAtTime(0.0001, t + decay);
			osc.connect(gain).connect(destination);
			osc.start(t);
			osc.stop(t + decay + 0.05);
		}
	}

	/** About 3 seconds: falling notes when focus ends (rest), rising when a break ends (back to work). */
	function chime(cue: 'rest' | 'work') {
		if (!audio) return;
		const ctx = audio;
		const t0 = ctx.currentTime + 0.05;
		const out = ctx.createGain();
		out.gain.value = 0.46;
		const limiter = ctx.createDynamicsCompressor();
		limiter.threshold.value = -6;
		limiter.ratio.value = 8;
		out.connect(limiter).connect(ctx.destination);

		// G5 E5 C5, then G4+C5 together / C5 E5 G5, then C6+G5 together.
		const notes = cue === 'rest' ? [783.99, 659.25, 523.25] : [523.25, 659.25, 783.99];
		const final = cue === 'rest' ? [392, 523.25] : [783.99, 1046.5];
		notes.forEach((freq, i) => bell(ctx, out, freq, t0 + i * 0.24, 0.45));
		final.forEach((freq) => bell(ctx, out, freq, t0 + notes.length * 0.24 + 0.06, 0.4));

		lofi?.duck(3.2);
	}

	// Lofi music. The player is created on first use, since audio needs a user gesture.
	const lofiRoot = $('lofi');
	const lofiToggle = $<HTMLButtonElement>('lofi-toggle');
	let lofi: LofiPlayer | undefined;

	function applyLofiPrefs() {
		if (!lofi) return;
		lofi.setVibe(settings.vibe);
		lofi.setVolume(settings.volume / 100);
		lofi.setRain(settings.rain);
		lofi.setCrackle(settings.crackle);
	}

	function setMusic(on: boolean) {
		if (on) {
			unlockAudio();
			if (!lofi) {
				lofi = new LofiPlayer(audio!);
				applyLofiPrefs();
			}
			lofi.start();
		} else {
			lofi?.stop();
		}
		lofiRoot.toggleAttribute('data-playing', on);
		lofiToggle.setAttribute('aria-pressed', String(on));
		lofiToggle.setAttribute('aria-label', on ? 'Pause lofi music' : 'Play lofi music');
	}

	// With "play during focus only", music follows the timer: on while a focus session runs, off otherwise.
	function syncMusicWithTimer() {
		if (settings.musicFollowsFocus) setMusic(isRunning() && mode === 'focus');
	}

	function renderLofiControls() {
		for (const button of document.querySelectorAll<HTMLButtonElement>('[data-vibe]')) {
			button.setAttribute('aria-pressed', String(button.dataset.vibe === settings.vibe));
		}
		$<HTMLInputElement>('lofi-volume').value = String(settings.volume);
		$<HTMLInputElement>('lofi-rain').checked = settings.rain;
		$<HTMLInputElement>('lofi-crackle').checked = settings.crackle;
		$<HTMLInputElement>('lofi-follow').checked = settings.musicFollowsFocus;
	}

	function updateLofi(patch: Partial<Settings>) {
		settings = { ...settings, ...patch };
		save(SETTINGS_KEY, settings);
		applyLofiPrefs();
		renderLofiControls();
	}

	lofiToggle.addEventListener('click', () => setMusic(!lofi?.playing));
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-vibe]')) {
		button.addEventListener('click', () => updateLofi({ vibe: button.dataset.vibe as VibeId }));
	}
	$<HTMLInputElement>('lofi-volume').addEventListener('input', (event) =>
		updateLofi({ volume: Number((event.target as HTMLInputElement).value) }),
	);
	$<HTMLInputElement>('lofi-rain').addEventListener('change', (event) =>
		updateLofi({ rain: (event.target as HTMLInputElement).checked }),
	);
	$<HTMLInputElement>('lofi-crackle').addEventListener('change', (event) =>
		updateLofi({ crackle: (event.target as HTMLInputElement).checked }),
	);
	$<HTMLInputElement>('lofi-follow').addEventListener('change', (event) => {
		updateLofi({ musicFollowsFocus: (event.target as HTMLInputElement).checked });
		syncMusicWithTimer();
	});
	renderLofiControls();

	// Wiring
	toggleButton.addEventListener('click', () => (isRunning() ? pause() : start()));
	$('test-chime').addEventListener('click', () => {
		unlockAudio();
		chime(mode === 'focus' ? 'rest' : 'work');
	});
	$('reset').addEventListener('click', () => setMode(mode));
	$('skip').addEventListener('click', skip);
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-mode-button]')) {
		button.addEventListener('click', () => setMode(button.dataset.modeButton as Mode));
	}

	document.addEventListener('keydown', (event) => {
		const target = event.target as HTMLElement;
		// Leave typing alone, and let Space activate a focused button/summary natively.
		if (event.altKey || event.ctrlKey || event.metaKey || target.closest('input, textarea, select')) return;
		if (event.key === ' ') {
			if (target.closest('button, summary')) return;
			event.preventDefault();
			toggleButton.click();
		} else if (event.key === 'r' || event.key === 'R') {
			setMode(mode);
		} else if (event.key === 's' || event.key === 'S') {
			skip();
		}
	});

	// Settings form: fill from saved values, save on every change.
	for (const [key, value] of Object.entries(settings)) {
		const input = form.elements.namedItem(key) as HTMLInputElement | null;
		if (!input) continue;
		if (input.type === 'checkbox') input.checked = Boolean(value);
		else input.value = String(value);
	}
	form.addEventListener('change', () => {
		const untouched = !isRunning() && remainingMs === durationMs(mode);
		const data = new FormData(form);
		const num = (name: keyof Settings, min: number, max: number) => {
			const n = Math.round(Number(data.get(name)));
			return Number.isFinite(n) && n >= min ? Math.min(n, max) : (DEFAULTS[name] as number);
		};
		settings = {
			...settings,
			focus: num('focus', 1, 120),
			short: num('short', 1, 60),
			long: num('long', 1, 60),
			longEvery: num('longEvery', 2, 10),
			autoBreaks: data.has('autoBreaks'),
			autoFocus: data.has('autoFocus'),
			sound: data.has('sound'),
		};
		save(SETTINGS_KEY, settings);
		// A session that hasn't started picks up the new duration; one under way keeps its time
		// (capped, so shortening the duration never leaves more time than the new length).
		if (untouched) {
			remainingMs = durationMs(mode);
		} else if (!isRunning()) {
			remainingMs = Math.min(remainingMs, durationMs(mode));
		}
		render();
	});
	form.addEventListener('submit', (event) => event.preventDefault());

	// Warn before leaving mid-session.
	window.addEventListener('beforeunload', (event) => {
		if (isRunning()) event.preventDefault();
	});

	render();
</script>

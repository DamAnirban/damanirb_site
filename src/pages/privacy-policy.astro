---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Privacy Policy — Anirban Dam"
	description="Privacy policy for anirbandam.com — what data this site does and does not collect."
>
	<section class="mx-auto max-w-2xl px-6 py-16 sm:py-24">
		<p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-coral">Legal</p>
		<h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-text sm:text-5xl">
			Privacy Policy
		</h1>
		<p class="mt-4 text-sm text-text/60">Effective October 7, 2026</p>

		<div class="mt-10 space-y-8 text-lg leading-relaxed text-text/80">
			<div>
				<h2 class="font-display text-xl font-semibold text-text">Overview</h2>
				<p class="mt-3">
					anirbandam.com is a personal portfolio site. It has no user accounts, no forms, and no
					analytics or advertising scripts running on it. This policy explains the little that is
					true about data on this site, in plain language.
				</p>
			</div>

			<div>
				<h2 class="font-display text-xl font-semibold text-text">Information collected</h2>
				<p class="mt-3">
					This site does not set cookies and does not collect personal information directly. The
					hosting provider, Netlify, may collect standard technical server logs (such as IP
					address and request data) for security and operational purposes, as described in <a
						href="https://www.netlify.com/privacy/"
						target="_blank"
						rel="noopener noreferrer"
						class="font-medium text-primary underline decoration-2 underline-offset-2 hover:text-coral"
						>Netlify's privacy policy</a
					>.
				</p>
			</div>

			<div>
				<h2 class="font-display text-xl font-semibold text-text">Third-party links</h2>
				<p class="mt-3">
					This site links out to external profiles, such as LinkedIn, for convenience. Once you
					follow a link away from this site, that destination's own privacy policy applies, not
					this one.
				</p>
			</div>

			<div>
				<h2 class="font-display text-xl font-semibold text-text">Children's privacy</h2>
				<p class="mt-3">
					This site is not directed at children and does not knowingly collect information from
					children.
				</p>
			</div>

			<div>
				<h2 class="font-display text-xl font-semibold text-text">Changes to this policy</h2>
				<p class="mt-3">
					If what this site collects or how it's hosted changes, this page will be updated and the
					effective date above will reflect the change.
				</p>
			</div>

			<div>
				<h2 class="font-display text-xl font-semibold text-text">Contact</h2>
				<p class="mt-3">
					Questions about this policy can be sent via <a
						href="/contact"
						class="font-medium text-primary underline decoration-2 underline-offset-2 hover:text-coral"
						>the contact page</a
					>.
				</p>
			</div>
		</div>
	</section>
</Layout>

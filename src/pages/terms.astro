---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Terms & Conditions — Anirban Dam"
	description="Terms and conditions for using anirbandam.com."
>
	<section class="mx-auto max-w-2xl px-6 py-16 sm:py-24">
		<p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-coral">Legal</p>
		<h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-text sm:text-5xl">
			Terms &amp; Conditions
		</h1>
		<p class="mt-4 text-sm text-text/60">Effective October 7, 2026</p>

		<div class="mt-10 space-y-8 text-lg leading-relaxed text-text/80">
			<div>
				<h2 class="font-display text-xl font-semibold text-text">Acceptance of terms</h2>
				<p class="mt-3">
					By using anirbandam.com, you agree to these terms. If you don't agree, the simplest
					option is not to use the site.
				</p>
			</div>

			<div>
				<h2 class="font-display text-xl font-semibold text-text">Use of content</h2>
				<p class="mt-3">
					The text, images, and design on this site belong to Anirban Dam unless otherwise noted.
					You're welcome to view and share links to it. Reproducing or redistributing it elsewhere
					without permission isn't permitted.
				</p>
			</div>

			<div>
				<h2 class="font-display text-xl font-semibold text-text">No warranty</h2>
				<p class="mt-3">
					This site is provided as-is, without warranties of any kind. There's no guarantee it
					will be accurate, uninterrupted, or error-free.
				</p>
			</div>

			<div>
				<h2 class="font-display text-xl font-semibold text-text">External links</h2>
				<p class="mt-3">
					Links to third-party sites, such as LinkedIn, are provided for convenience. Anirban Dam
					isn't responsible for the content, accuracy, or practices of sites linked from here.
				</p>
			</div>

			<div>
				<h2 class="font-display text-xl font-semibold text-text">Limitation of liability</h2>
				<p class="mt-3">
					To the extent permitted by law, Anirban Dam isn't liable for any damages arising from
					your use of, or inability to use, this site.
				</p>
			</div>

			<div>
				<h2 class="font-display text-xl font-semibold text-text">Changes to these terms</h2>
				<p class="mt-3">
					These terms may be updated from time to time. Continuing to use the site after a change
					means you accept the updated terms.
				</p>
			</div>

			<div>
				<h2 class="font-display text-xl font-semibold text-text">Contact</h2>
				<p class="mt-3">
					Questions about these terms can be sent via <a
						href="/contact"
						class="font-medium text-primary underline decoration-2 underline-offset-2 hover:text-coral"
						>the contact page</a
					>.
				</p>
			</div>
		</div>
	</section>
</Layout>

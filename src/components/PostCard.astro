---
import { getEntry } from 'astro:content';
import PostCover from './PostCover.astro';
import { formatDate, type Post } from '../lib/content';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { title, description, date, type, pdf, track: trackRef, draft } = post.data;
const track = trackRef ? await getEntry(trackRef) : undefined;
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-text/10 bg-canvas/80 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-secondary hover:shadow-xl hover:shadow-primary/10">
	<PostCover post={post} />
	<div class="flex flex-1 flex-col p-5">
		<div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
			<span class:list={['rounded-full px-2.5 py-0.5', type === 'video' ? 'bg-primary text-canvas' : 'bg-blush text-primary']}>
				{type === 'video' ? 'Video' : 'Article'}
			</span>
			{pdf && <span class="rounded-full border border-text/15 px-2.5 py-0.5 text-text/70">PDF notes</span>}
			{draft && <span class="rounded-full bg-coral px-2.5 py-0.5 text-text">Draft</span>}
			<time datetime={date.toISOString()} class="font-medium text-text/60">{formatDate(date)}</time>
		</div>
		<h3 class="mt-3 font-display text-lg leading-snug font-semibold text-text">
			<!-- The whole card is clickable via this link's ::after. -->
			<a href={`/blog/${post.id}`} class="after:absolute after:inset-0 focus:outline-none focus-visible:after:rounded-2xl focus-visible:after:ring-2 focus-visible:after:ring-primary">
				{title}
			</a>
		</h3>
		<p class="mt-2 line-clamp-3 text-sm leading-relaxed text-text/70">{description}</p>
		{track && <p class="mt-auto pt-4 text-xs font-semibold text-primary">{track.data.title}</p>}
	</div>
</article>

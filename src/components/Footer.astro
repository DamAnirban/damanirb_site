---
const year = new Date().getUTCFullYear();
---

<footer class="border-t border-text/10">
	<div class="mx-auto flex max-w-5xl flex-col items-center gap-4 px-6 py-10 text-center sm:flex-row sm:justify-between sm:text-left">
		<p class="text-sm text-text/70">&copy; {year} Anirban Dam.</p>
		<a
			href="https://www.linkedin.com/in/anirban-dam/"
			target="_blank"
			rel="noopener noreferrer"
			class="text-sm font-medium text-text underline decoration-coral decoration-2 underline-offset-4 transition-colors hover:text-coral focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-canvas rounded-sm"
		>
			Connect on LinkedIn
		</a>
	</div>
</footer>
